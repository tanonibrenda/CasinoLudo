<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.CasinoLudo" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/amarillo_ficha</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/verde_mesa</item>
        <item name="android:windowBackground">@color/verde_mesa</item>
    </style>

    <style name="Theme.CasinoLudo" parent="Base.Theme.CasinoLudo" />

    <!-- Títulos amarillos con borde negro, como en la propuesta -->
    <style name="TextoTitulo">
        <item name="android:textColor">@color/amarillo_ficha</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:shadowColor">@color/black</item>
        <item name="android:shadowDx">3</item>
        <item name="android:shadowDy">3</item>
        <item name="android:shadowRadius">2</item>
    </style>

    <style name="TextoSubtitulo" parent="TextoTitulo">
        <item name="android:textSize">20sp</item>
    </style>

    <!-- Botón amarillo con borde negro -->
    <style name="BotonFicha" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/amarillo_ficha</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="strokeColor">@color/black</item>
        <item name="strokeWidth">2dp</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:minHeight">64dp</item>
    </style>

    <!-- Botón secundario (Salir, Borrar) -->
    <style name="BotonSecundario" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/black</item>
        <item name="strokeColor">@color/black</item>
        <item name="backgroundTint">@color/white</item>
    </style>

    <!-- Tarjeta blanca para contenidos sobre el paño verde -->
    <style name="Tarjeta" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/white</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="strokeColor">@color/black</item>
        <item name="strokeWidth">2dp</item>
    </style>
</resources>
