<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.CasinoLudo" parent="Theme.Material3.Light.NoActionBar">
        <!-- Verde oscuro para RadioButton marcado, foco, etc. (7.9:1 sobre blanco).
             El amarillo sobre blanco daba 1.3:1 y no se veía cuál opción estaba marcada. -->
        <item name="colorPrimary">@color/verde_cero</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/verde_mesa</item>
        <item name="android:windowBackground">@color/verde_mesa</item>
    </style>

    <style name="Theme.CasinoLudo" parent="Base.Theme.CasinoLudo" />

    <!-- Títulos amarillos sobre un recuadro oscuro, así se leen bien sobre el verde -->
    <style name="TextoTitulo">
        <item name="android:textColor">@color/amarillo_ficha</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_titulo</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>

    <style name="TextoSubtitulo" parent="TextoTitulo">
        <item name="android:textSize">20sp</item>
    </style>

    <!-- Botón amarillo con borde negro -->
    <style name="BotonFicha" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/amarillo_ficha</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="strokeColor">@color/black</item>
        <item name="strokeWidth">2dp</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:minHeight">64dp</item>
    </style>

    <!-- Botón secundario (Salir, Borrar) -->
    <style name="BotonSecundario" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">88dp</item>
        <item name="strokeColor">@color/black</item>
        <item name="backgroundTint">@color/white</item>
    </style>

    <!-- Tarjeta blanca para contenidos sobre el paño verde -->
    <style name="Tarjeta" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/white</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="strokeColor">@color/black</item>
        <item name="strokeWidth">2dp</item>
    </style>
</resources>
