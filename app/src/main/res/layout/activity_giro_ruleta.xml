<?xml version="1.0" encoding="utf-8"?>
<!-- Giro único de la ruleta + consulta del color a la API -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/verde_mesa"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp"
    tools:context=".GiroRuletaActivity">

    <TextView
        android:id="@+id/tvEstado"
        style="@style/TextoTitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="24sp"
        tools:text="Está girando la ruleta…" />

    <!-- Marcador fijo arriba de la ruleta -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="▼"
        android:textColor="@color/amarillo_ficha"
        android:textSize="32sp"
        tools:ignore="HardcodedText" />

    <ImageView
        android:id="@+id/imgRuleta"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:contentDescription="@string/desc_ruleta"
        android:src="@drawable/img_ruleta" />

    <ProgressBar
        android:id="@+id/progreso"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnReintentar"
        style="@style/BotonFicha"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/boton_reintentar"
        android:visibility="gone" />
</LinearLayout>
