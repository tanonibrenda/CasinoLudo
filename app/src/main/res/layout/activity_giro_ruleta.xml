<?xml version="1.0" encoding="utf-8"?>
<!-- Giro único de la ruleta + consulta del color a la API -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/verde_mesa"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp"
    tools:context=".GiroRuletaActivity">

    <TextView
        style="@style/TextoTitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/girando" />

    <ImageView
        android:id="@+id/imgRuleta"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_marginTop="32dp"
        android:contentDescription="@string/desc_imagen_ruleta"
        android:src="@drawable/img_ruleta" />

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progreso"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:indeterminate="true" />

    <TextView
        android:id="@+id/txtEstado"
        style="@style/TextoSubtitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/consultando_color" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnReintentar"
        style="@style/BotonFicha"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/boton_reintentar"
        android:visibility="gone" />
</LinearLayout>
