<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo oscuro detrás de los títulos amarillos.
     Amarillo sobre el verde da contraste 1.84:1 (no cumple WCAG).
     Amarillo sobre este negro da 12.15:1 (cumple AAA, que pide 7:1). -->
